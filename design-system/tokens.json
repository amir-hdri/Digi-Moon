  "typography": {
    "fontFamily": {
      "sans": {
        "$value": [
          "IRANSans",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ],
        "$type": "fontFamily",
        "$description": "Primary Persian font family with fallback stack"
      },
      "mono": {
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Monaco",
          "Consolas",
          "Liberation Mono",
          "Courier New",
          "monospace"
        ],
        "$type": "fontFamily"
      }
    },
    "fontWeight": {
      "light": {
        "$value": "300",
        "$type": "fontWeight"
      },
      "normal": {
        "$value": "400",
        "$type": "fontWeight"
      },
      "medium": {
        "$value": "500",
        "$type": "fontWeight"
      },
      "semibold": {
        "$value": "600",
        "$type": "fontWeight"
      },
      "bold": {
        "$value": "700",
        "$type": "fontWeight"
      },
      "extrabold": {
        "$value": "800",
        "$type": "fontWeight"
      },
      "black": {
        "$value": "900",
        "$type": "fontWeight",
        "$description": "Brand logo and key display headings"
      }
    },
    "fontSize": {
      "xs": {
        "$value": "0.75rem",
        "$type": "dimension",
        "lineHeight": "calc(1 / 0.75)"
      },
      "sm": {
        "$value": "0.875rem",
        "$type": "dimension",
        "lineHeight": "calc(1.25 / 0.875)"
      },
      "base": {
        "$value": "1rem",
        "$type": "dimension",
        "lineHeight": "1.5"
      },
      "lg": {
        "$value": "1.125rem",
        "$type": "dimension",
        "lineHeight": "calc(1.75 / 1.125)"
      },
      "xl": {
        "$value": "1.25rem",
        "$type": "dimension",
        "lineHeight": "calc(1.75 / 1.25)"
      },
      "2xl": {
        "$value": "1.5rem",
        "$type": "dimension",
        "lineHeight": "calc(2 / 1.5)"
      },
      "3xl": {
        "$value": "1.875rem",
        "$type": "dimension",
        "lineHeight": "calc(2.25 / 1.875)"
      },
      "4xl": {
        "$value": "2.25rem",
        "$type": "dimension",
        "lineHeight": "calc(2.5 / 2.25)"
      },
      "5xl": {
        "$value": "3rem",
        "$type": "dimension",
        "lineHeight": "1"
      },
      "8xl": {
        "$value": "6rem",
        "$type": "dimension",
        "lineHeight": "1"
      }
    },
    "letterSpacing": {
      "wide": {
        "$value": "0.025em",
        "$type": "dimension"
