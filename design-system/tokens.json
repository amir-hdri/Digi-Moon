    },
    "full": {
      "$value": "9999px",
      "$type": "dimension",
      "$description": "Floating badges, circular buttons, pills"
    }
  },
  "elevation": {
    "drop-sm": {
      "$value": "0 1px 2px #00000026",
      "$type": "shadow"
    },
    "drop-md": {
      "$value": "0 3px 3px #0000001f",
      "$type": "shadow"
    },
    "sm": {
      "$value": "0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1)",
      "$type": "shadow"
    },
    "md": {
      "$value": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1)",
      "$type": "shadow",
      "$description": "Product card default shadow"
    },
    "lg": {
      "$value": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1)",
      "$type": "shadow",
      "$description": "Search input, action buttons"
    },
    "xl": {
      "$value": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1)",
      "$type": "shadow",
      "$description": "Sticky top header, category cards"
    },
    "2xl": {
      "$value": "0 25px 50px -12px rgba(0, 0, 0, 0.25)",
      "$type": "shadow",
      "$description": "Fixed bottom navigation bar, modals"
    }
  },
  "blur": {
    "sm": {
      "$value": "8px",
      "$type": "dimension"
    },
    "md": {
      "$value": "12px",
      "$type": "dimension",
      "$description": "Core glassmorphism backdrop blur"
    },
    "xl": {
      "$value": "24px",
      "$type": "dimension"
    },
    "2xl": {
      "$value": "40px",
      "$type": "dimension"
    }
  },
  "motion": {
    "transition": {
      "default": {
        "duration": {
          "$value": "150ms",
          "$type": "duration"
        },
        "timingFunction": {
          "$value": "cubic-bezier(0.4, 0, 0.2, 1)",
          "$type": "cubicBezier"
        }
      },
      "medium": {
        "duration": {
          "$value": "200ms",
          "$type": "duration"
        },
        "timingFunction": {
          "$value": "cubic-bezier(0.4, 0, 0.2, 1)",
          "$type": "cubicBezier"
        }
      }
    },
    "animation": {
      "floating": {
        "$value": "floating 2s ease-in-out infinite",
        "$type": "string",
        "$description": "Subtle vertical float for cart notification badge"
      },
      "pulse": {
        "$value": "pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite",
        "$type": "string",
        "$description": "Skeleton loader breathing pulse"
      },
      "spin": {
        "$value": "spin 1s linear infinite",
        "$type": "string"
      }
    }
  }
}